# Example environment variables for Vercel production deployment
# Add these to your Vercel project settings under Environment Variables

# API Base URL - your actual backend API URL
VITE_API_BASE_URL=https://your-backend-api.com

# Examples:
# - If using Make.com webhook: VITE_API_BASE_URL=https://hook.us1.make.com
# - If using your own API: VITE_API_BASE_URL=https://api.yourdomain.com
# - If using Vercel serverless functions: VITE_API_BASE_URL= (leave empty)
